# The dashboard's settings. Next reads NEXT_PUBLIC_* at build time and bakes them into the
# static pages, so they are public by design: never put a secret here. Copy to .env.local
# for `pnpm --filter web dev`, or set them in the shell before `pnpm --filter web build`.
# Every value can be left out; the defaults are noted.

# The keeper whose REST API the dashboard reads. Default: the hosted sim keeper.
# The real keeper will be https://lifeline-keeper.prashantthakur.dev
NEXT_PUBLIC_KEEPER_API_URL=https://lifeline-sim.prashantthakur.dev

# The always-on sim keeper behind the no-wallet demo (demo.near). The demo reads it whatever
# NEXT_PUBLIC_KEEPER_API_URL points at. Default: https://lifeline-sim.prashantthakur.dev
NEXT_PUBLIC_SIM_KEEPER_API_URL=https://lifeline-sim.prashantthakur.dev

# mainnet or testnet. Default: mainnet. 1Click has no testnet, so funding only works on mainnet.
NEXT_PUBLIC_NEAR_NETWORK=mainnet

# JSON-RPC for view calls. Default: https://free.rpc.fastnear.com on mainnet,
# https://test.rpc.fastnear.com on testnet (https://docs.near.org/api/rpc/providers).
NEXT_PUBLIC_NEAR_RPC_URL=

# The vault contract. Leave empty until it is deployed: the pages say so, and everything
# that doesn't need the vault keeps working. Example: vault.fake-team.near
NEXT_PUBLIC_VAULT_ID=

# The keeper account a new policy names, the only one allowed to call rescue for the user.
# Leave empty and set_policy can't be signed. Example: keeper.fake-team.near
NEXT_PUBLIC_KEEPER_ACCOUNT_ID=

# Optional: the USDC contract. Default: native USDC on NEAR mainnet,
# 17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1. Set it on testnet.
NEXT_PUBLIC_USDC_CONTRACT_ID=
