# Copy to .env and fill in real values. Every value below is fake.
# Real keys go only in .env and the team password manager, never in git or chat.

# --- NEAR ---
# testnet or mainnet. The URLs come from https://docs.near.org/api/rpc/providers.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Mainnet RPC: https://free.rpc.fastnear.com
VAULT_CONTRACT_ID=vault.fake-team.testnet
KEEPER_ACCOUNT_ID=keeper.fake-team.testnet
# Function-call key limited to vault.rescue. A hands it to B through the password manager.
KEEPER_PRIVATE_KEY=ed25519:fake-keeper-function-call-key

# Testnet only: the key the testnet vault trusts to sign quotes, since 1Click has no testnet.
# Used by `pnpm latency --near-testnet`, `pnpm demo:attack --send-testnet` and the attack lab.
TESTNET_QUOTE_SIGNER_KEY=ed25519:fake-testnet-quote-signer-key

# Testnet only: the rescue-only key of lab-keeper.lifeline-team.testnet, which the public
# attack lab (/attack) signs its attacks with. The sim keeper runs the lab when it has this
# key and TESTNET_QUOTE_SIGNER_KEY; the real keeper never gets either.
TESTNET_LAB_KEEPER_KEY=ed25519:fake-lab-keeper-function-call-key

# Optional, for `pnpm demo:attack`: the nodes it re-checks the saved vault refusal on, read
# from the shell, not from this file. Default: fastnear's regular node, then its archival one.
# PROOF_RPC_URL=
# PROOF_ARCHIVAL_RPC_URL=

# --- Hyperliquid ---
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz

# --- Tidepool proof (testnet only) ---
# Used by `pnpm demo:tidepool`: a real NEAR testnet deposit through Tidepool, a community
# 1Click-compatible testnet sandbox, into a Hyperliquid testnet perps balance.
# A NEAR testnet account holding Tidepool's test USDC, and its full-access key.
NEAR_TESTNET_ACCOUNT=fake-account.testnet
NEAR_TESTNET_PRIVATE_KEY=ed25519:fake-near-testnet-private-key
# The Hyperliquid testnet account the USDC is paid to. The key is never used to sign by the
# demo; it's kept so the account can be used in the Hyperliquid testnet app.
HL_TESTNET_ADDRESS=0x0000000000000000000000000000000000000000
HL_TESTNET_PRIVATE_KEY=0xfake-hyperliquid-testnet-private-key

# --- 1Click ---
ONECLICK_API_URL=https://1click.chaindefuser.com
# Optional. Register at https://partners.near-intents.org.
ONECLICK_JWT=fake-optional-1click-jwt

# --- NEAR AI Cloud ---
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=fake-near-ai-api-key
# A private model, so it runs in a TEE and can be attested. Real IDs: https://cloud-api.near.ai/v1/models
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017

# --- Telegram ---
TELEGRAM_BOT_TOKEN=000000000:fake-telegram-bot-token
TELEGRAM_BOT_USERNAME=fake_lifeline_bot

# --- Keeper ---
KEEPER_PORT=8787
KEEPER_DB_PATH=./data/keeper.sqlite
DASHBOARD_URL=http://localhost:3000
# Optional: who may call the API from a browser. Defaults to DASHBOARD_URL, or * without one.
CORS_ORIGIN=
# Optional: accounts to watch besides everyone registered in the vault, comma-separated.
# The keeper reads the vault's get_users once a minute, so dashboard sign-ups need nothing here.
KEEPER_USERS=
# Mainnet moves real money. Set this to yes only once a human has agreed.
KEEPER_ALLOW_MAINNET=no

# --- Cloudflare (apps/keeper/wrangler.jsonc) ---
# The hosted keeper reads the same names as --live. KEEPER_MODE (sim or live) and PUBLIC_URL
# are set in wrangler.jsonc. Secrets go in with `wrangler secret put NAME`, never in a file:
# KEEPER_PRIVATE_KEY, TELEGRAM_BOT_TOKEN, NEAR_AI_API_KEY, ONECLICK_JWT.

# --- Dashboard ---
# apps/web reads its own settings at build time: see apps/web/.env.example. They're all public.
